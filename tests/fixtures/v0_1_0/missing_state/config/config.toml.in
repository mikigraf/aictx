version = 1

[settings]
require_billing_confirmation_on_change = true
show_run_banner = true
telemetry = false

[binaries]
claude = "claude"
codex = "codex"

[profiles."claude:solo"]
provider = "claude"
billing_domain = "anthropic-api"
auth = "api-key"
state_dir = "{{LEGACY_ROOT}}/data/vendor-state/claude/solo"
secret_ref = "keyring://aictx/claude-solo-frozen-v010"
account_hint = "solo-v010@example.test"
